# 보통은 이 파일을 직접 고칠 필요가 없습니다.
# start.cmd 를 실행하면 열리는 http://localhost:8790 화면(또는 폰 앱 화면)에서 키를 넣으면 .env 가 만들어집니다.
# 직접 쓰고 싶으면 이 파일을 복사해 이름을 ".env" 로 바꾸고 아래를 채우세요. 키는 이 PC 에만 있습니다.

# 네이버 클라우드 콘솔 > Maps > Application > 인증 정보
# (Application 에서 Reverse Geocoding, Geocoding, Directions 5 를 체크)
NAVER_MAP_KEY_ID=
NAVER_MAP_KEY=

# (선택) 장소 이름 검색: 네이버 클라우드 콘솔 > NAVER API HUB > 검색 API Application 의 인증 정보
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# (선택) 음성으로 목적지: Google AI Studio(aistudio.google.com) > Get API key
GEMINI_API_KEY=

# (선택) 이 PC 가 한 달에 부를 최대 횟수. 네이버 콘솔 한도와 함께 이중으로 막음
# REVGEO_MONTHLY_LIMIT=3000
# GEOCODE_MONTHLY_LIMIT=1000
# SEARCH_MONTHLY_LIMIT=3000
# DIRECTIONS_MONTHLY_LIMIT=1000
# PORT=8790
